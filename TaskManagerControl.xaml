<UserControl x:Class="CyberSecurityChatbot.TaskManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgDeep"      Color="#0D0F1A"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#111827"/>
        <SolidColorBrush x:Key="AccentCyan"  Color="#00FFFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF88"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderCol"   Color="#1E3A5F"/>

        <Style x:Key="CyberLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1526"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CyberBtn" TargetType="Button">
            <Setter Property="Background" Value="#003D66"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource CyberBtn}">
            <Setter Property="Background" Value="#4A0000"/>
            <Setter Property="Foreground" Value="#FF6666"/>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource CyberBtn}">
            <Setter Property="Background" Value="#003D1F"/>
            <Setter Property="Foreground" Value="#00FF88"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDeep}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,1,0"
                Padding="20">

            <StackPanel>

                <TextBlock x:Name="FormTitle"
                           Text="📋 ADD TASK"
                           Foreground="{StaticResource AccentCyan}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Style="{StaticResource CyberLabel}" Text="Task Title *"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource CyberInput}" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource CyberLabel}" Text="Description"/>
                <TextBox x:Name="DescBox" Style="{StaticResource CyberInput}"
                         Height="70" AcceptsReturn="True" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource CyberLabel}" Text="Reminder Date"/>
                <DatePicker x:Name="ReminderPicker" Margin="0,0,0,20"/>

                <Button x:Name="AddTaskBtn"
                        Style="{StaticResource CyberBtn}"
                        Content="➕ Add Task"
                        Click="AddTask_Click"/>

                <Button x:Name="CancelEditBtn"
                        Style="{StaticResource DangerBtn}"
                        Content="✖ Cancel Edit"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        Click="CancelEdit_Click"/>

                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource AccentGreen}"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="DbErrorText"
                           Foreground="#FF6666"
                           Margin="0,5,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderCol}"
                    BorderThickness="0,0,0,1"
                    Padding="15">

                <DockPanel>
                    <TextBlock Text="📋 TASKS"
                               Foreground="{StaticResource AccentCyan}"
                               FontWeight="Bold"
                               FontSize="13"
                               DockPanel.Dock="Left"/>

                    <Button Content="🔄 Refresh"
                            Style="{StaticResource CyberBtn}"
                            DockPanel.Dock="Right"
                            Click="Refresh_Click"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="10">
                <ItemsControl x:Name="TaskList">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#111827"
                                    BorderBrush="#1E3A5F"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding Path="StatusDisplay" Mode="OneWay"/>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Foreground="#00FFFF">
                                            <TextBlock.Text>
                                                <Binding Path="ReminderDisplay" Mode="OneWay"/>
                                            </TextBlock.Text>
                                        </TextBlock>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">

                                        <Button Content="✅ Done"
                                                Style="{StaticResource GreenBtn}"
                                                Tag="{Binding Id}"
                                                Click="MarkDone_Click"
                                                Margin="0,0,0,5"/>

                                        <Button Content="✏ Edit"
                                                Style="{StaticResource CyberBtn}"
                                                Tag="{Binding Id}"
                                                Click="EditTask_Click"
                                                Margin="0,0,0,5"/>

                                        <Button Content="🗑 Delete"
                                                Style="{StaticResource DangerBtn}"
                                                Tag="{Binding Id}"
                                                Click="DeleteTask_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>