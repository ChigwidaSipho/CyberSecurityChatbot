<UserControl x:Class="CyberSecurityChatbot.ChatbotGUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CyberSecurityChatbot"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>

        <SolidColorBrush x:Key="BgDeep"       Color="#0D0F1A"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#111827"/>
        <SolidColorBrush x:Key="BgBubbleBot"  Color="#1A2740"/>
        <SolidColorBrush x:Key="BgBubbleUser" Color="#0E3A2F"/>
        <SolidColorBrush x:Key="AccentCyan"   Color="#00FFFF"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#00FF88"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderColor"  Color="#FFFFFF"/>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1E3A5F" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{StaticResource SlimScrollBar}"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#0D1526"/>
            <Setter Property="Foreground"      Value="#E2E8F0"/>
            <Setter Property="CaretBrush"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00FFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#003D66"/>
            <Setter Property="Foreground"      Value="#00FFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00AACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Button">
            <Setter Property="Background"      Value="#0D1526"/>
            <Setter Property="Foreground"      Value="#00FFFF"/>
            <Setter Property="BorderBrush"     Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2740"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00FFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource BgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38"
                        Background="#001F3F" CornerRadius="8" VerticalAlignment="Center">
                    <TextBlock Text="🛡" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CYBERSECURITY AWARENESS SYSTEM"
                               Foreground="{StaticResource AccentCyan}"
                               FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Your personal online safety assistant"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Online"
                               Foreground="{StaticResource AccentGreen}"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CHAT -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll"
                      Style="{StaticResource ChatScrollViewer}" Padding="0,8">
            <StackPanel x:Name="MessagePanel" Margin="16,4" VerticalAlignment="Bottom"/>
        </ScrollViewer>

        <!-- CHIPS -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Margin="16,0">
                <TextBlock Text="Quick topics:"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Style="{StaticResource ChipStyle}" Content="🔑 Passwords"
                        Click="Chip_Click" Tag="Tell me about passwords"/>
                <Button Style="{StaticResource ChipStyle}" Content="🎣 Phishing"
                        Click="Chip_Click" Tag="What is phishing?"/>
                <Button Style="{StaticResource ChipStyle}" Content="🌐 Safe Browsing"
                        Click="Chip_Click" Tag="Safe browsing tips"/>
                <Button Style="{StaticResource ChipStyle}" Content="🔒 Privacy"
                        Click="Chip_Click" Tag="Tell me about privacy"/>
                <Button Style="{StaticResource ChipStyle}" Content="❓ Help"
                        Click="Chip_Click" Tag="What can you help me with?"/>
            </StackPanel>
        </Border>

        <!-- INPUT -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox"
                         Style="{StaticResource InputBoxStyle}"
                         Height="38" VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" x:Name="SendButton"
                        Style="{StaticResource SendButtonStyle}"
                        Content="Send ➤" Height="38" Margin="8,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>